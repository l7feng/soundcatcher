# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 运行时产物
data/
data-test/
*.db
*.db-wal
*.db-shm
*.faiss

# 模型文件（≈1GB，不随仓分发）
#
# 自 2026-09-22 起 models/ 位于本仓内（SoundCatcher\models\），但**不入版本控制**
# —— 与 data/ 同款处理：「仓文件夹＝项目文件夹」，靠 .gitignore 划界。
# 落点由 soundcatcher.config 解析（SOUNDCATCHER_MODELS > home.parent/models > home/models）。
# 获取方式：python scripts/download_models.py
models/
**/models/*.onnx
*.onnx
*.npy

# 第三方参考资料（只读思路参考；内含独立 git 仓 ucs-tools；不入版本控制）
# 例外：Reference/PROVENANCE.md 记录三方来源与版本，需入库
Reference/*
!Reference/PROVENANCE.md

# 待删文件整理区（坏文件「只移不删」登记区，运行态暂存；不入版本控制）
_to_clean/

# 一次性调试产物
_probe_*.json
_probe_*.txt
*.orig.bak
*.pre-*

# 测试截图 / 渲染产物（tests/_render/<时间戳>/；只新建从不删，交用户清理）
tests/_render/

# 测试脚本的运行日志（本机沙箱里 Qt 脚本的 stdout 会被偶发吞掉，
# 测试一律把结果落盘到这些 *_*.log，判定看日志不看退出码）
tests/_*.log
