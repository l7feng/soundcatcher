# 模型文件（≈1GB，不随仓分发）
#
# 自 2026-09-19 起 models/ 已移出本仓，位于工程层：
#   D:\Ai-Files\App-Project\Sound-library\models\
# 落点由 soundcatcher.config 解析（SOUNDCATCHER_MODELS > 工程层 > 仓内）。
# 获取方式：python scripts/download_models.py
models/
**/models/*.onnx
*.onnx
*.npy

# 一次性调试产物
_probe_*.json
_probe_*.txt
*.orig.bak
*.pre-*

# 测试截图 / 渲染产物（tests/_render/<时间戳>/；只新建从不删，交用户清理）
tests/_render/

# 测试脚本的运行日志（本机沙箱里 Qt 脚本的 stdout 会被偶发吞掉，
# 测试一律把结果落盘到这些 *_*.log，判定看日志不看退出码）
tests/_*.log
